# shellcheck shell=bash

export DIRENV_LOG_FORMAT=

if command -v devenv &>/dev/null; then
  eval "$(devenv direnvrc)"
  use devenv
else
  # --no-pure-eval: devenv.lib.mkShell needs $PWD to set devenv.root; see
  # modules/devshell.nix and https://devenv.sh/guides/using-with-flakes/.
  use flake . --no-pure-eval
fi
